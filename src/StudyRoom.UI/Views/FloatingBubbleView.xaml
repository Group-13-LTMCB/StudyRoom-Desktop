<Window x:Class="StudyRoom.UI.Views.FloatingBubbleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
        xmlns:models="clr-namespace:StudyRoom.Core.Models;assembly=StudyRoom.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FloatingBubbleViewModel}"
        Title="StudyRoom Chat &amp; Member Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid Margin="16">
        <!-- ========================================================================= -->
        <!-- 1. COLLAPSED FLOATING MEMBER DOCK & CHAT PILL (Reference Image 1 Style)   -->
        <!-- ========================================================================= -->
        <Border x:Name="CollapsedBubble"
                Width="56"
                CornerRadius="28"
                Background="#E61A1626"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="6,12"
                Cursor="Hand"
                ToolTip="Thanh Dock Thành viên &amp; Chat Nổi (Bấm để mở, kéo để di chuyển)"
                PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Bubble_PreviewMouseLeftButtonUp"
                MouseMove="Bubble_MouseMove">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- Mac-Style Window Control Dots (Reference Image 1) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,3,0" />
                    <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,3,0" />
                    <Ellipse Width="6" Height="6" Fill="#10B981" />
                </StackPanel>

                <!-- Mini Quick Add Button -->
                <Border Width="32" Height="32" CornerRadius="16" Background="#26FFFFFF" Margin="0,0,0,10">
                    <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>

                <!-- Member Avatars with Glowing Online Status (Reference Image 1) -->
                <StackPanel Margin="0,0,0,10">
                    <!-- Member 1: Sally (Host) -->
                    <Grid Width="34" Height="34" Margin="0,0,0,8">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#3B82F6">
                            <TextBlock Text="👩‍🎓" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="#10B981" Stroke="#1A1626" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Member 2: Alex -->
                    <Grid Width="34" Height="34" Margin="0,0,0,8">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#EC4899">
                            <TextBlock Text="👨‍💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="#10B981" Stroke="#1A1626" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Member 3: Elena -->
                    <Grid Width="34" Height="34" Margin="0,0,0,8">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#F59E0B">
                            <TextBlock Text="🧑‍🔬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="#6366F1" Stroke="#1A1626" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>

                <Rectangle Height="1" Fill="#26FFFFFF" Width="26" Margin="0,0,0,10" />

                <!-- Chat Bubble Action Circle -->
                <Border Width="38" Height="38" CornerRadius="19">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0" />
                            <GradientStop Color="#8B5CF6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Unread Dot Badge -->
                        <Border Width="11" Height="11" CornerRadius="5.5" Background="#10B981"
                                BorderBrush="#1A1626" BorderThickness="1.5"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. EXPANDED DARK GLASS CHAT WINDOW (Reference Image 1 Style)              -->
        <!-- ========================================================================= -->
        <Border x:Name="ExpandedChatBox"
                Width="390"
                Height="520"
                CornerRadius="20"
                Background="#F216131D"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Rate Limit Warning Banner -->
                    <RowDefinition Height="Auto" />
                    <!-- Chat Messages List -->
                    <RowDefinition Height="*" />
                    <!-- Message Input Area -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Bar (Drag Move Handle & Mac Dots) -->
                <Border Grid.Row="0"
                        Padding="16,14"
                        Background="#26FFFFFF"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Mac Window Dots -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" />
                            <Ellipse Width="10" Height="10" Fill="#10B981" />
                        </StackPanel>

                        <!-- Chat Info / Recipient -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="StudyRoom Chat" FontWeight="Bold" FontSize="14" Foreground="White" />
                                <Border Background="#2210B981" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock Text="● 4 Trực tuyến" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Nhấn Ctrl+Shift+C để ẩn/hiện tức thì" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Collapse Button -->
                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Padding="0" Margin="0,0,6,0"
                                Command="{Binding ToggleExpandCommand}"
                                ToolTip="Thu nhỏ về thanh dock"
                                Background="#1AFFFFFF"
                                BorderThickness="0"
                                Foreground="#CBD5E1"
                                Cursor="Hand"
                                Content="🗕" />

                        <!-- Close Button -->
                        <Button Grid.Column="3"
                                Width="28" Height="28"
                                Padding="0"
                                Command="{Binding CloseCommand}"
                                ToolTip="Đóng chat"
                                Background="#1AFFFFFF"
                                BorderThickness="0"
                                Foreground="#CBD5E1"
                                Cursor="Hand"
                                Content="✕" />
                    </Grid>
                </Border>

                <!-- Rate Limit Warning Banner -->
                <Border Grid.Row="1"
                        Margin="12,8,12,2"
                        Padding="10,6"
                        CornerRadius="10"
                        Background="#33EF4444"
                        BorderBrush="#EF4444"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRateLimited}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⏳" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RateLimitWarning}"
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ClearWarningCommand}"
                                Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FCA5A5"
                                Padding="6,0"
                                Cursor="Hand"
                                ToolTip="Đóng cảnh báo" />
                    </Grid>
                </Border>

                <!-- Messages List (Reference Image 1 Speech Bubbles) -->
                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,10">
                    <Grid>
                        <!-- Empty State Notice -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,8" />
                            <TextBlock Text="Chưa có tin nhắn trong phòng." FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                            <TextBlock Text="Hãy gửi lời chào đầu tiên đến các bạn học nhé! 👋" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Items of ChatMessage -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ChatMessage}">
                                    <Grid Margin="0,6">
                                        <Border x:Name="MessageBubble"
                                                CornerRadius="16"
                                                Padding="14,10"
                                                MaxWidth="280">
                                            <StackPanel>
                                                <TextBlock x:Name="SenderText"
                                                           Text="{Binding SenderName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                           FontSize="9"
                                                           Foreground="#DDD6FE"
                                                           Opacity="0.75"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- Other User's Message: Dark Violet Card (Reference Image 1) -->
                                        <DataTrigger Binding="{Binding IsSelf}" Value="False">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Left" />
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#2A2438" />
                                            <Setter TargetName="MessageBubble" Property="CornerRadius" Value="16,16,16,4" />
                                            <Setter TargetName="SenderText" Property="Foreground" Value="#C084FC" />
                                            <Setter TargetName="SenderText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Self Message: Purple/Indigo Gradient Pill (Reference Image 1) -->
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="MessageBubble" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6366F1" Offset="0" />
                                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="MessageBubble" Property="CornerRadius" Value="16,16,4,16" />
                                            <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Message Input Area (Reference Image 1 Rounded Dark Pill) -->
                <Border Grid.Row="3"
                        Padding="14,10,14,14"
                        Background="#1E192B"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- Pill Shaped Input Background -->
                        <Border Background="#282238" CornerRadius="20" Padding="12,4" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="MessageInputTextBox"
                                         Grid.Column="0"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13"
                                         Foreground="White"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Padding="4,6"
                                         KeyDown="MessageInputTextBox_KeyDown" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SendButton"
                                            Width="32" Height="32"
                                            Padding="0"
                                            Command="{Binding SendMessageCommand}"
                                            ToolTip="Gửi tin nhắn (Enter)"
                                            Background="#6366F1"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                    <TextBlock Text="➤" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>