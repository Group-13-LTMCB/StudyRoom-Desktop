<Window x:Class="StudyRoom.UI.Views.FloatingBubbleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
        xmlns:models="clr-namespace:StudyRoom.Core.Models;assembly=StudyRoom.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FloatingBubbleViewModel}"
        Title="StudyRoom Chat Bubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid Margin="16">
        <!-- ======================================================== -->
        <!-- 1. COLLAPSED FLOATING BUBBLE (When IsExpanded == False)  -->
        <!-- ======================================================== -->
        <Border x:Name="CollapsedBubble"
                Width="60"
                Height="60"
                CornerRadius="30"
                Cursor="Hand"
                ToolTip="StudyRoom Chat (Bấm để mở, kéo để di chuyển)"
                PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Bubble_PreviewMouseLeftButtonUp"
                MouseMove="Bubble_MouseMove">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0" />
                    <GradientStop Color="#8B5CF6" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black" />
            </Border.Effect>

            <Grid>
                <!-- Chat Icon -->
                <TextBlock Text="💬"
                           FontSize="26"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Unread Indicator Dot if any messages exist -->
                <Border Width="14" Height="14"
                        CornerRadius="7"
                        Background="#10B981"
                        BorderBrush="White"
                        BorderThickness="1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. EXPANDED CHAT BOX (When IsExpanded == True)           -->
        <!-- ======================================================== -->
        <Border x:Name="ExpandedChatBox"
                Width="360"
                Height="480"
                CornerRadius="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Rate Limit Warning Banner -->
                    <RowDefinition Height="Auto" />
                    <!-- Chat Messages List -->
                    <RowDefinition Height="*" />
                    <!-- Message Input Area -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Bar (Drag Move Handle) -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        CornerRadius="16,16,0,0"
                        Background="#1E1E2E"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="StudyRoom Chat" FontWeight="Bold" FontSize="13" Foreground="White" />
                            <TextBlock Text="Nhấn Ctrl+Shift+C để ẩn/hiện" FontSize="10" Foreground="#94A3B8" />
                        </StackPanel>

                        <!-- Collapse Button -->
                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Padding="0" Margin="0,0,4,0"
                                Command="{Binding ToggleExpandCommand}"
                                ToolTip="Thu nhỏ thành bong bóng"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94A3B8"
                                Cursor="Hand"
                                Content="🗕" />

                        <!-- Close Button -->
                        <Button Grid.Column="3"
                                Width="28" Height="28"
                                Padding="0"
                                Command="{Binding CloseCommand}"
                                ToolTip="Đóng chat"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94A3B8"
                                Cursor="Hand"
                                Content="✕" />
                    </Grid>
                </Border>

                <!-- Rate Limit Warning Banner -->
                <Border Grid.Row="1"
                        Margin="12,6,12,2"
                        Padding="10,6"
                        CornerRadius="8"
                        Background="#33EF4444"
                        BorderBrush="#EF4444"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRateLimited}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⏳" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RateLimitWarning}"
                                   Foreground="#FCA5A5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ClearWarningCommand}"
                                Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FCA5A5"
                                Padding="6,0"
                                Cursor="Hand"
                                ToolTip="Đóng cảnh báo" />
                    </Grid>
                </Border>

                <!-- Messages List -->
                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,8">
                    <Grid>
                        <!-- Empty State Notice -->
                        <TextBlock Text="Chưa có tin nhắn nào. Hãy gửi lời chào đến phòng học nhé! 👋"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="20,40">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Items of ChatMessage -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ChatMessage}">
                                    <Grid Margin="0,4">
                                        <Border x:Name="MessageBubble"
                                                CornerRadius="12"
                                                Padding="10,7"
                                                MaxWidth="260">
                                            <StackPanel>
                                                <TextBlock x:Name="SenderText"
                                                           Text="{Binding SenderName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                           FontSize="9"
                                                           Foreground="#E2E8F0"
                                                           Opacity="0.7"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- Other User's Message (IsSelf == False) -->
                                        <DataTrigger Binding="{Binding IsSelf}" Value="False">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Left" />
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#2D3748" />
                                            <Setter TargetName="SenderText" Property="Foreground" Value="#94A3B8" />
                                            <Setter TargetName="SenderText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Self Message (IsSelf == True) -->
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#6366F1" />
                                            <Setter TargetName="SenderText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Message Input Area -->
                <Border Grid.Row="3"
                        Padding="12,8,12,12"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageInputTextBox"
                                 Grid.Column="0"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13"
                                 Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 KeyDown="MessageInputTextBox_KeyDown" />

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="14,8"
                                Command="{Binding SendMessageCommand}"
                                Content="Gửi"
                                FontWeight="SemiBold"
                                Background="#6366F1"
                                Foreground="White"
                                Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
