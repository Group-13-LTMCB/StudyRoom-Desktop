<UserControl x:Class="StudyRoom.UI.Views.DashboardView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"

             xmlns:views="clr-namespace:StudyRoom.UI.Views"

             xmlns:components="clr-namespace:StudyRoom.UI.Views.Components"

             xmlns:coreEnums="clr-namespace:StudyRoom.Core.Enums;assembly=StudyRoom.Core"

             mc:Ignorable="d" 

             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"

             d:DesignHeight="850" d:DesignWidth="1280">



    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">

        <Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->

            <!-- 0. Far-Left Group Server Rail -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="72" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <!-- 1. Left Sidebar Navigation -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="210" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>

            <!-- Main Content Area -->

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <!-- ========================================== -->

        <!-- 1. LEFT SIDEBAR NAVIGATION                 -->

        <!-- ========================================== -->

        <!-- 0. GROUP SERVER RAIL -->
        <components:GroupRailControl Grid.Column="0" DataContext="{Binding GroupRailVm}">
            <components:GroupRailControl.Style>
                <Style TargetType="components:GroupRailControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsZenMode, RelativeSource={RelativeSource AncestorType=views:DashboardView}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:GroupRailControl.Style>
        </components:GroupRailControl>

        <Border Grid.Column="1" 

                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 

                BorderThickness="0,0,1,0" 

                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"

                Padding="16,20,16,20">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsZenMode, RelativeSource={RelativeSource AncestorType=views:DashboardView}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>



                <!-- Brand / Logo Area -->

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,28" VerticalAlignment="Center">

                    <Border Width="34" Height="34" CornerRadius="10" Background="#6366F1" Margin="0,0,12,0">

                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="StudyRoom" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="Không gian học tập số" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    </StackPanel>

                </StackPanel>



                <!-- Navigation Menu Items -->

                <StackPanel Grid.Row="1">

                    <!-- Overview (Active item when SelectedNavIndex == 0) -->

                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="0"

                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"

                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">

                        <ui:Button.Style>

                            <Style TargetType="ui:Button">

                                <Setter Property="Background" Value="Transparent" />

                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />

                                <Setter Property="FontWeight" Value="Normal" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">

                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />

                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />

                                        <Setter Property="FontWeight" Value="SemiBold" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </ui:Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" />

                            <TextBlock Text="Tổng quan" />

                        </StackPanel>

                    </ui:Button>



                    <!-- Room item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="3"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Phòng học" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Pomodoro item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="1"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Pomodoro" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Kanban item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="2"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Nhiệm vụ &amp; Kanban" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Statistics item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="4"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Thống kê" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Community item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="5"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="5">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Cộng đồng" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Messages item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="6"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="6">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Tin nhắn" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Bottom Controls: Settings, Theme Toggle, Logout -->


                <StackPanel Grid.Row="2">

                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="7"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,8" Margin="0,0,0,4" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="7">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,12,0" Opacity="0.7" />
                            <TextBlock Text="Hỗ trợ &amp; Trợ giúp" FontSize="13" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="8"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,8" Margin="0,0,0,12" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="8">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,12,0" Opacity="0.7" />
                            <TextBlock Text="Cài đặt hệ thống" FontSize="13" />
                        </StackPanel>
                    </ui:Button>



                    <!-- Theme Toggle Switcher -->

                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 

                            CornerRadius="12" 

                            Padding="12,8" 

                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="{Binding ThemeIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding ThemeLabel}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                            </StackPanel>



                            <!-- Theme Toggle Action Button -->

                            <ui:Button Grid.Column="2" 

                                    Command="{Binding ToggleThemeCommand}" 

                                    Background="#6366F1" 

                                    Foreground="White"

                                    BorderThickness="0"

                                    CornerRadius="14"

                                    Padding="10,4"

                                    FontSize="11"

                                    FontWeight="SemiBold"

                                    Content="{Binding CurrentThemeName}" />

                        </Grid>

                    </Border>



                    <!-- Log Out -->

                    <ui:Button Command="{Binding LogoutCommand}"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               CornerRadius="10" Padding="12,8">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22EF4444" />
                                        <Setter Property="Foreground" Value="#EF4444" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🚪" FontSize="14" Margin="0,0,12,0" Opacity="0.6" />

                            <TextBlock Text="Đăng xuất" FontSize="13" Opacity="0.8" />

                        </StackPanel>

                    </ui:Button>

                </StackPanel>

            </Grid>

        </Border>



        <!-- ========================================== -->

        <!-- 2. MAIN CONTENT AREA (Overview / Pomodoro) -->

        <!-- ========================================== -->

        <Grid Grid.Column="2">

            <!-- VIEW 0: OVERVIEW -->

            <Grid>

                <Grid.Style>

                    <Style TargetType="Grid">

                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">

                                <Setter Property="Visibility" Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Grid.Style>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="340" />

                </Grid.ColumnDefinitions>



                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24,20,24,24">



                <!-- Header Greeting & Search Bar -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <TextBlock Text="{Binding Greeting}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="Cùng tiếp tục hoàn thành các mục tiêu học tập ngày hôm nay." FontSize="13" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />

                    </StackPanel>



                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Search Box -->

                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 

                                CornerRadius="10" 

                                Padding="12,6" 

                                Width="260"

                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"

                                BorderThickness="1"

                                Margin="0,0,12,0">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <TextBox Grid.Column="1" 

                                         Background="Transparent" 

                                         BorderThickness="0" 

                                         FontSize="12" 

                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" 

                                         VerticalAlignment="Center"

                                         Padding="0" />

                            </Grid>

                        </Border>



                        <!-- Notification Bell Icon -->

                        <Border Width="36" Height="36" 

                                CornerRadius="10" 

                                Background="{DynamicResource ControlFillColorSecondaryBrush}" 

                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 

                                BorderThickness="1"

                                Margin="0,0,8,0">

                            <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>



                        <!-- Filter Options Icon -->

                        <Border Width="36" Height="36" 

                                CornerRadius="10" 

                                Background="{DynamicResource ControlFillColorSecondaryBrush}" 

                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 

                                BorderThickness="1">

                            <TextBlock Text="⚙️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                    </StackPanel>

                </Grid>



                <!-- Hero Banner Card -->

                <Border CornerRadius="16" Margin="0,0,0,20" Padding="24,20">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <GradientStop Color="#1E1B4B" Offset="0" />

                            <GradientStop Color="#0F172A" Offset="1" />

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>



                        <!-- Hero Banner Text Content -->

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                            <TextBlock Text="Tiếp tục học tập &amp; Chinh phục mục tiêu! 🚀" 

                                       FontSize="19" 

                                       FontWeight="Bold" 

                                       Foreground="White" />

                            <TextBlock Text="Tham gia phòng học nhóm Pomodoro ngay hôm nay để nhận chuỗi điểm chuyên cần và thảo luận cùng cộng đồng sinh viên." 

                                       FontSize="12" 

                                       Foreground="#CBD5E1" 

                                       Margin="0,8,0,16" 

                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">

                                <ui:Button Command="{Binding QuickJoinRoomCommand}" 

                                        Background="#6366F1" 

                                        Foreground="White" 

                                        FontWeight="SemiBold" 

                                        FontSize="13" 

                                        CornerRadius="8" 

                                        Padding="18,8" 

                                        BorderThickness="0"

                                        Content="Tham gia phòng học ngay" />

                            </StackPanel>

                        </StackPanel>



                        <!-- Hero Banner Decorative Badges -->

                        <Border Grid.Column="1" 

                                Width="120" Height="100" 

                                Background="#1E293B" 

                                CornerRadius="14" 

                                BorderBrush="#334155" 

                                BorderThickness="1"

                                Padding="10"

                                VerticalAlignment="Center"

                                Margin="16,0,0,0">

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                <TextBlock Text="🔥" FontSize="26" HorizontalAlignment="Center" />

                                <TextBlock Text="Chuỗi 7 Ngày" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                <TextBlock Text="Top 5% Chuyên Cần" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>



                <!-- 3 Stat Cards Grid -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <!-- Stat Card 1: Focus Time Today (Lime Accent from Dashboard Mockups) -->

                    <Border Grid.Column="0" 

                            Background="#C7F284" 

                            CornerRadius="16" 

                            Padding="18,16" 

                            Margin="0,0,10,0">

                        <StackPanel>

                            <Border Width="34" Height="34" CornerRadius="17" Background="#111827" HorizontalAlignment="Left" Margin="0,0,0,10">

                                <TextBlock Text="⏱️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="{Binding FocusTimeToday}" FontSize="24" FontWeight="Bold" Foreground="#111827" />

                            <TextBlock Text="Thời gian tập trung hôm nay" FontSize="12" FontWeight="Medium" Foreground="#1F2937" Margin="0,4,0,2" />

                            <TextBlock Text="{Binding FocusTimeTrend}" FontSize="11" Foreground="#374151" Opacity="0.85" />

                        </StackPanel>

                    </Border>



                    <!-- Stat Card 2: Completed Tasks (Soft Lavender / Primary Card) -->

                    <Border Grid.Column="1" 

                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 

                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"

                            BorderThickness="1"

                            CornerRadius="16" 

                            Padding="18,16" 

                            Margin="5,0,5,0">

                        <StackPanel>

                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">

                                <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="{Binding CompletedTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Text="Nhiệm vụ hoàn thành" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,2" />

                            <TextBlock Text="{Binding CompletedTasksTrend}" FontSize="11" Foreground="#6366F1" FontWeight="Medium" />

                        </StackPanel>

                    </Border>



                    <!-- Stat Card 3: Study Streak (Flame / Dark Card) -->

                    <Border Grid.Column="2" 

                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 

                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"

                            BorderThickness="1"

                            CornerRadius="16" 

                            Padding="18,16" 

                            Margin="10,0,0,0">

                        <StackPanel>

                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">

                                <TextBlock Text="🔥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="{Binding StudyStreak}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Text="Chuỗi học tập liên tục" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,2" />

                            <TextBlock Text="{Binding StudyStreakTrend}" FontSize="11" Foreground="#F59E0B" FontWeight="Medium" />

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- Dual Analytics Grid: Concentric Rings & Vector Spline Chart (Reference Image 2) -->
                <Grid Margin="0,0,0,20">
