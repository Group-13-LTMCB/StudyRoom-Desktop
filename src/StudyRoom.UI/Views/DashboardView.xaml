<UserControl x:Class="StudyRoom.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
             xmlns:views="clr-namespace:StudyRoom.UI.Views"
             xmlns:components="clr-namespace:StudyRoom.UI.Views.Components"
             xmlns:coreEnums="clr-namespace:StudyRoom.Core.Enums;assembly=StudyRoom.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="850" d:DesignWidth="1280">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="230" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- 1. LEFT SIDEBAR NAVIGATION                 -->
        <!-- ========================================== -->
        <Border Grid.Column="0" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="0,0,1,0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="16,20,16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand / Logo Area -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,28" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#6366F1" Margin="0,0,12,0">
                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="StudyRoom" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Không gian học tập số" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <StackPanel Grid.Row="1">
                    <!-- Overview (Active item when SelectedNavIndex == 0) -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="0"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Tổng quan" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Room item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="1"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Phòng học" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Pomodoro item -->
                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="1"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Pomodoro" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Command="{Binding NavigateToCommand}" CommandParameter="2"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="12,10" Margin="0,0,0,6" CornerRadius="10" BorderThickness="0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="Nhiệm vụ &amp; Kanban" />
                        </StackPanel>
                    </ui:Button>

                    <Border Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="15" Margin="0,0,12,0" Opacity="0.75" />
                            <TextBlock Text="Thống kê" Opacity="0.75" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="15" Margin="0,0,12,0" Opacity="0.75" />
                            <TextBlock Text="Cộng đồng" Opacity="0.75" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="15" Margin="0,0,12,0" Opacity="0.75" />
                            <TextBlock Text="Tin nhắn" Opacity="0.75" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Controls: Settings, Theme Toggle, Logout -->
                <StackPanel Grid.Row="2">
                    <Border Background="Transparent" CornerRadius="10" Padding="12,8" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,12,0" Opacity="0.7" />
                            <TextBlock Text="Hỗ trợ &amp; Trợ giúp" FontSize="13" Opacity="0.7" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,12,0" Opacity="0.7" />
                            <TextBlock Text="Cài đặt hệ thống" FontSize="13" Opacity="0.7" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Theme Toggle Switcher -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="12" 
                            Padding="12,8" 
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ThemeIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ThemeLabel}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Theme Toggle Action Button -->
                            <ui:Button Grid.Column="2" 
                                    Command="{Binding ToggleThemeCommand}" 
                                    Background="#6366F1" 
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Content="{Binding CurrentThemeName}" />
                        </Grid>
                    </Border>

                    <!-- Log Out -->
                    <Border Background="Transparent" CornerRadius="10" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="14" Margin="0,0,12,0" Opacity="0.6" />
                            <TextBlock Text="Đăng xuất" FontSize="13" Opacity="0.6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 2. MAIN CONTENT AREA (Overview / Pomodoro) -->
        <!-- ========================================== -->
        <Grid Grid.Column="1">
            <!-- VIEW 0: OVERVIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- Header Greeting & Search Bar -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Cùng tiếp tục hoàn thành các mục tiêu học tập ngày hôm nay." FontSize="13" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                CornerRadius="10" 
                                Padding="12,6" 
                                Width="260"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="12" 
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                         VerticalAlignment="Center"
                                         Padding="0" />
                            </Grid>
                        </Border>

                        <!-- Notification Bell Icon -->
                        <Border Width="36" Height="36" 
                                CornerRadius="10" 
                                Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1"
                                Margin="0,0,8,0">
                            <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Filter Options Icon -->
                        <Border Width="36" Height="36" 
                                CornerRadius="10" 
                                Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1">
                            <TextBlock Text="⚙️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Hero Banner Card -->
                <Border CornerRadius="16" Margin="0,0,0,20" Padding="24,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hero Banner Text Content -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Tiếp tục học tập &amp; Chinh phục mục tiêu! 🚀" 
                                       FontSize="19" 
                                       FontWeight="Bold" 
                                       Foreground="White" />
                            <TextBlock Text="Tham gia phòng học nhóm Pomodoro ngay hôm nay để nhận chuỗi điểm chuyên cần và thảo luận cùng cộng đồng sinh viên." 
                                       FontSize="12" 
                                       Foreground="#CBD5E1" 
                                       Margin="0,8,0,16" 
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding QuickJoinRoomCommand}" 
                                        Background="#6366F1" 
                                        Foreground="White" 
                                        FontWeight="SemiBold" 
                                        FontSize="13" 
                                        CornerRadius="8" 
                                        Padding="18,8" 
                                        BorderThickness="0"
                                        Content="Tham gia phòng học ngay" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Hero Banner Decorative Badges -->
                        <Border Grid.Column="1" 
                                Width="120" Height="100" 
                                Background="#1E293B" 
                                CornerRadius="14" 
                                BorderBrush="#334155" 
                                BorderThickness="1"
                                Padding="10"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="26" HorizontalAlignment="Center" />
                                <TextBlock Text="Chuỗi 7 Ngày" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <TextBlock Text="Top 5% Chuyên Cần" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3 Stat Cards Grid -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Stat Card 1: Focus Time Today (Lime Accent from Dashboard Mockups) -->
                    <Border Grid.Column="0" 
                            Background="#C7F284" 
                            CornerRadius="16" 
                            Padding="18,16" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#111827" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="⏱️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding FocusTimeToday}" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="Thời gian tập trung hôm nay" FontSize="12" FontWeight="Medium" Foreground="#1F2937" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding FocusTimeTrend}" FontSize="11" Foreground="#374151" Opacity="0.85" />
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 2: Completed Tasks (Soft Lavender / Primary Card) -->
                    <Border Grid.Column="1" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16" 
                            Padding="18,16" 
                            Margin="5,0,5,0">
                        <StackPanel>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding CompletedTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Nhiệm vụ hoàn thành" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding CompletedTasksTrend}" FontSize="11" Foreground="#6366F1" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 3: Study Streak (Flame / Dark Card) -->
                    <Border Grid.Column="2" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16" 
                            Padding="18,16" 
                            Margin="10,0,0,0">
                        <StackPanel>
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🔥" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding StudyStreak}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Chuỗi học tập liên tục" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding StudyStreakTrend}" FontSize="11" Foreground="#F59E0B" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Weekly Activity Vector Spline Chart Section -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="20">
                    <StackPanel>
                        <!-- Chart Subheader & Timeframe Switchers -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Subheader Navigation Tabs -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Hiệu suất tuần" FontSize="14" FontWeight="Bold" Foreground="#6366F1" />
                                    <Border Height="2" Background="#6366F1" Margin="0,4,0,0" CornerRadius="1" />
                                </StackPanel>
                                <TextBlock Text="Thống kê tháng" FontSize="13" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" VerticalAlignment="Top" />
                                <TextBlock Text="Lịch sử chi tiết" FontSize="13" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                            </StackPanel>

                            <!-- Timeframe Pills (1W, 1M, 1Y, ALL) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Command="{Binding ChangeTimeframeCommand}" CommandParameter="1W"
                                        Content="1T" FontSize="11"
                                        Padding="10,4" Margin="2,0" CornerRadius="6" BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTimeframe}" Value="1W">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Command="{Binding ChangeTimeframeCommand}" CommandParameter="1M"
                                        Content="1Th" FontSize="11"
                                        Padding="10,4" Margin="2,0" CornerRadius="6" BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTimeframe}" Value="1M">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Command="{Binding ChangeTimeframeCommand}" CommandParameter="1Y"
                                        Content="1N" FontSize="11"
                                        Padding="10,4" Margin="2,0" CornerRadius="6" BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTimeframe}" Value="1Y">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Command="{Binding ChangeTimeframeCommand}" CommandParameter="ALL"
                                        Content="Tất cả" FontSize="11"
                                        Padding="10,4" Margin="2,0" CornerRadius="6" BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTimeframe}" Value="ALL">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Smooth Bézier Curve Vector Line Chart Component -->
                        <components:WeeklyActivityChart ActivityPoints="{Binding WeeklyActivityPoints}" Height="230" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- 3. RIGHT STUDENT HUB PANEL                 -->
        <!-- ========================================== -->
        <Border Grid.Column="1" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="1,0,0,0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="18,20,18,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Student Profile Summary Card -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Circular Avatar with Neon Gradient Ring -->
                            <Border Width="64" Height="64" CornerRadius="32" Padding="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6366F1" Offset="0" />
                                        <GradientStop Color="#EC4899" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#1E1F26" CornerRadius="30">
                                    <TextBlock Text="👩‍🎓" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>

                            <TextBlock Text="{Binding UserName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding UserMajor}" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,12" />

                            <TextBlock Text="Tổng thời gian học tập" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalStudyTime}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,8" />

                            <!-- Rank Pill Badge -->
                            <Border Background="#203222" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RankBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Feedback Alert Banners -->
                    <!-- Error Alert -->
                    <Border CornerRadius="10" 
                            Background="#301A1A" 
                            BorderBrush="#EF4444" 
                            BorderThickness="1" 
                            Padding="12,10" 
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ValidationErrorMessage}" FontSize="12" Foreground="#F87171" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Success Alert -->
                    <Border CornerRadius="10" 
                            Background="#18301E" 
                            BorderBrush="#22C55E" 
                            BorderThickness="1" 
                            Padding="12,10" 
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuccessMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SuccessMessage}" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Quick Room Hub (Vào phòng & Tạo phòng) -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="16">
                        <StackPanel>
                            <!-- Tab Header Pills -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" 
                                        Command="{Binding SelectJoinTabCommand}"
                                        Content="Vào phòng" 
                                        FontSize="12" 
                                        FontWeight="SemiBold"
                                        Padding="0,8" 
                                        Margin="0,0,4,0" 
                                        CornerRadius="8" 
                                        BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHubTabIndex}" Value="0">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <ui:Button Grid.Column="1" 
                                        Command="{Binding SelectCreateTabCommand}"
                                        Content="Tạo phòng" 
                                        FontSize="12" 
                                        FontWeight="SemiBold"
                                        Padding="0,8" 
                                        Margin="4,0,0,0" 
                                        CornerRadius="8" 
                                        BorderThickness="0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHubTabIndex}" Value="1">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>

                            <!-- Tab 0: Vào phòng (Join Room) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHubTabIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel>
                                    <TextBlock Text="Nhập mã phòng 6 chữ số:" FontSize="12" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding JoinRoomCode, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="13" 
                                             Padding="10,7" 
                                             Margin="0,0,0,10" />

                                    <ui:Button Command="{Binding JoinRoomCommand}" 
                                            Background="#6366F1" 
                                            Foreground="White" 
                                            FontWeight="SemiBold" 
                                            FontSize="13" 
                                            Padding="0,10" 
                                            CornerRadius="8" 
                                            HorizontalAlignment="Stretch" 
                                            Content="Tham gia phòng học" />

                                    <!-- Recent Rooms List Header -->
                                    <TextBlock Text="Phòng học đang hoạt động" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,18,0,8" />

                                    <!-- ItemsControl for Active Rooms -->
                                    <ItemsControl ItemsSource="{Binding ActiveRooms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="10" 
                                                        Padding="10,8" 
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding RoomName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Subject}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                                                                <TextBlock FontSize="10" Opacity="0.6">
                                                                    <Run Text="Mã: " /><Run Text="{Binding RoomId}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock FontSize="11" Opacity="0.8">
                                                                    <Run Text="{Binding MembersCount}" /><Run Text="/" /><Run Text="{Binding MaxMembers}" /><Run Text=" 👤" />
                                                                </TextBlock>
                                                            </Border>

                                                            <ui:Button Command="{Binding DataContext.QuickJoinRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                    CommandParameter="{Binding}"
                                                                    Content="Vào" 
                                                                    FontSize="11" 
                                                                    FontWeight="SemiBold" 
                                                                    Padding="8,3" 
                                                                    CornerRadius="6" 
                                                                    Background="#6366F1" 
                                                                    Foreground="White" 
                                                                    BorderThickness="0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- Tab 1: Tạo phòng (Create Room) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHubTabIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel>
                                    <TextBlock Text="Tên phòng học mới:" FontSize="12" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewRoomName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="10,7" 
                                             Margin="0,0,0,10" />

                                    <TextBlock Text="Môn học hoặc chủ đề:" FontSize="12" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewRoomSubject, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="12" 
                                             Padding="10,7" 
                                             Margin="0,0,0,10" />

                                    <TextBlock Text="Chế độ quản lý phòng:" FontSize="12" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,14">
                                        <RadioButton GroupName="ControlModeGroup"
                                                     Content="Chỉ chủ phòng quản lý đồng hồ (Host Only)" 
                                                     IsChecked="{Binding IsHostOnlyMode, Mode=TwoWay}" 
                                                     FontSize="11" 
                                                     Margin="0,2,0,4" 
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <RadioButton GroupName="ControlModeGroup"
                                                     Content="Tất cả thành viên bình đẳng (Equal)" 
                                                     IsChecked="{Binding IsEqualMode, Mode=TwoWay}" 
                                                     FontSize="11" 
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <ui:Button Command="{Binding CreateRoomCommand}" 
                                            Background="#6366F1" 
                                            Foreground="White" 
                                            FontWeight="SemiBold" 
                                            FontSize="13" 
                                            Padding="0,10" 
                                            CornerRadius="8" 
                                            HorizontalAlignment="Stretch" 
                                            Content="Tạo phòng học ngay" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
            </Grid>

            <!-- VIEW 1: POMODORO ROOM VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:PomodoroRoomView DataContext="{Binding PomodoroRoomVm}" />
            </Grid>

            <!-- VIEW 2: KANBAN BOARD VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:KanbanBoardView DataContext="{Binding KanbanVm}" />
            </Grid>
        </Grid>

    </Grid>
</UserControl>
