                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ Bảo mật 2 lớp (MFA / Authenticator)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MfaStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Bảo vệ tài khoản bằng Google Authenticator hoặc Microsoft Authenticator (Hoàn toàn miễn phí 0đ)" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Command="{Binding OpenMfaSettingsCommand}" Background="#10B981" Foreground="White" FontWeight="SemiBold" Padding="16,8" CornerRadius="10" Content="Cài đặt 2FA" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔑 Đổi mật khẩu tài khoản" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Cập nhật mật khẩu định kỳ để bảo vệ dữ liệu học tập và bảo mật tài khoản" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" Command="{Binding OpenChangePasswordCommand}" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" Padding="16,8" CornerRadius="10" Content="Đổi mật khẩu" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="👤 Tài khoản hiện tại" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                                        <Run Text="Người dùng: " />
                                        <Run Text="{Binding UserName}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Run Text=" • Chuyên ngành: " />
                                        <Run Text="{Binding UserMajor}" />
                                    </TextBlock>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Command="{Binding LogoutCommand}" Content="Đăng xuất" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="16,8" CornerRadius="10" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>



    </Grid>

</UserControl>

