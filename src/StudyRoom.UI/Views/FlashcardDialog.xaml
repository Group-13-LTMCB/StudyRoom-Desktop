<Window x:Class="StudyRoom.UI.Views.FlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FlashcardViewModel}"
        Title="Thử thách Flashcard - StudyRoom"
        Height="460" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 3D Flip Card Storyboard: Front to Back -->
        <Storyboard x:Key="FlipToBackStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace"
                                           Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace"
                                           Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.0" To="1.0"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 3D Flip Card Storyboard: Back to Front -->
        <Storyboard x:Key="FlipToFrontStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackFace"
                                           Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontFace"
                                           Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.0" To="1.0"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Dialog Outer Card -->
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: Timer Bar -->
                <RowDefinition Height="Auto" />
                <!-- 2: 3D Flip Card Area -->
                <RowDefinition Height="*" />
                <!-- 3: Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Tag & Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="⚡ THỬ THÁCH NHANH" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Command="{Binding CloseDialogCommand}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="6"
                           Cursor="Hand">
                    <TextBlock Text="✕" FontSize="14" Opacity="0.7" />
                </ui:Button>
            </Grid>

            <!-- Row 1: Countdown Progress Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Value="{Binding TimeProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             Height="6"
                             Foreground="#F59E0B"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Còn " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding RemainingSeconds}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                    <TextBlock Text="s" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Row 2: 3D Flip Card -->
            <Border Grid.Row="2"
                    x:Name="CardHost"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,16"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                </Border.RenderTransform>

                <Grid>
                    <!-- FRONT FACE: Question -->
                    <Grid x:Name="FrontFace" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="CÂU HỎI:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#3B82F6"
                                   Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Question}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="💡 Bấm 'Lật thẻ' bên dưới để xem đáp án"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </Grid>

                    <!-- BACK FACE: Answer -->
                    <Grid x:Name="BackFace" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="ĐÁP ÁN CHÍNH XÁC:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Answer}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="Bạn đã trả lời đúng câu hỏi này không?"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Flip Button -->
                <ui:Button Grid.Column="1"
                           Command="{Binding FlipCardCommand}"
                           Appearance="Secondary"
                           Padding="18,8"
                           CornerRadius="8"
                           Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Lật thẻ 3D" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Answer Evaluation Buttons (Shown on Back Face) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVis}}">
                    <ui:Button Command="{Binding MarkCorrectCommand}"
                               Appearance="Success"
                               Margin="0,0,6,0"
                               Padding="14,8"
                               CornerRadius="8"
                               ToolTip="Đã thuộc câu này"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Đã nhớ" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Command="{Binding MarkIncorrectCommand}"
                               Appearance="Danger"
                               Padding="14,8"
                               CornerRadius="8"
                               ToolTip="Cần ôn lại sau"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Chưa nhớ" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
