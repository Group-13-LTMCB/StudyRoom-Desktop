<ui:FluentWindow x:Class="StudyRoom.UI.Views.Components.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ChangePasswordViewModel}"
        Title="Đổi Mật Khẩu Tài Khoản"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ResizeMode="NoResize">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Form Card -->
            <RowDefinition Height="*" />
            <!-- 2. Messages & Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="#F59E0B" Margin="0,0,12,0">
                    <TextBlock Text="🔑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đổi Mật Khẩu" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Cập nhật mật khẩu mới cho tài khoản của bạn" 
                               FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 1. Form Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <!-- Old Password -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Mật khẩu hiện tại" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="OldPasswordInput"
                                    PlaceholderText="Nhập mật khẩu hiện tại"
                                    PasswordChanged="OldPasswordInput_PasswordChanged"
                                    Height="40" />
                </StackPanel>

                <!-- New Password -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Mật khẩu mới (ít nhất 8 ký tự)" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="NewPasswordInput"
                                    PlaceholderText="Nhập mật khẩu mới"
                                    PasswordChanged="NewPasswordInput_PasswordChanged"
                                    Height="40" />
                </StackPanel>

                <!-- Confirm Password -->
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Xác nhận mật khẩu mới" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <ui:PasswordBox x:Name="ConfirmPasswordInput"
                                    PlaceholderText="Nhập lại mật khẩu mới"
                                    PasswordChanged="ConfirmPasswordInput_PasswordChanged"
                                    Height="40" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Messages & Actions -->
        <StackPanel Grid.Row="2">
            <!-- Error message -->
            <Border Background="#22EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Success message -->
            <Border Background="#2210B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                    Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#10B981" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Command="{Binding ChangePasswordCommand}"
                           Appearance="Primary"
                           Height="42"
                           CornerRadius="10"
                           Margin="0,0,8,0">
                    <Grid>
                        <TextBlock Text="Cập nhật mật khẩu 🔒" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </ui:Button>

                <ui:Button Grid.Column="1"
                           Command="{Binding CloseCommand}"
                           Content="Đóng"
                           Height="42" Padding="20,0"
                           CornerRadius="10" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
