<UserControl x:Class="StudyRoom.UI.Views.Components.WeeklyActivityChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="600"
             SizeChanged="OnSizeChanged">
    <Grid ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Y-Axis Labels -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,20,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="8h" FontSize="11" Opacity="0.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,0,0" />
            <TextBlock Grid.Row="1" Text="6h" FontSize="11" Opacity="0.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,0,0" />
            <TextBlock Grid.Row="2" Text="4h" FontSize="11" Opacity="0.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,0,0" />
            <TextBlock Grid.Row="3" Text="2h" FontSize="11" Opacity="0.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,0,0" />
            <TextBlock Grid.Row="3" Text="0h" FontSize="11" Opacity="0.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-6" />
        </Grid>

        <!-- Chart Plot Area -->
        <Canvas x:Name="ChartCanvas" Grid.Row="0" Grid.Column="1" ClipToBounds="False">
            <!-- Grid Lines -->
            <Line x:Name="GridLineTop" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.25" />
            <Line x:Name="GridLineMidHigh" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.25" />
            <Line x:Name="GridLineMid" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.25" />
            <Line x:Name="GridLineMidLow" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.25" />
            <Line x:Name="GridLineBottom" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.35" />

            <!-- Area Fill -->
            <Path x:Name="AreaPath">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#506366F1" Offset="0" />
                        <GradientStop Color="#006366F1" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Line Curve -->
            <Path x:Name="CurvePath"
                  Stroke="#6366F1"
                  StrokeThickness="3"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <!-- Highlight Guide Line -->
            <Line x:Name="HighlightGuideLine"
                  Stroke="#7C3AED"
                  StrokeThickness="1.5"
                  StrokeDashArray="2 2"
                  Opacity="0.7"
                  Visibility="Collapsed" />

            <!-- Point Dots Layer -->
            <Canvas x:Name="DotsLayer" />

            <!-- Highlight Tooltip Pill -->
            <Border x:Name="HighlightTooltip"
                    Background="#1E1F26"
                    BorderBrush="#7C3AED"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,4"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TooltipText"
                               Text="6.8h"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="TooltipDayText"
                               Text=" • T5"
                               FontSize="11"
                               Opacity="0.75"
                               Foreground="#A5B4FC"
                               Margin="4,0,0,0" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- X-Axis Day Labels -->
        <UniformGrid x:Name="XAxisGrid" Grid.Row="1" Grid.Column="1" Rows="1" Margin="0,8,0,0">
            <TextBlock Text="T2" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="T3" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="T4" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="T5" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="T6" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="T7" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
            <TextBlock Text="CN" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
        </UniformGrid>
    </Grid>
</UserControl>
