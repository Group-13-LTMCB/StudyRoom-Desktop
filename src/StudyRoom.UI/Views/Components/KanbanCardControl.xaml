<UserControl x:Class="StudyRoom.UI.Views.Components.KanbanCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:KanbanCardItemViewModel}"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             MouseMove="OnMouseMove"
             Cursor="Hand">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,12"
            Margin="0,0,0,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.08" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Tag Badge & Delete Button -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                        BorderBrush="{Binding PriorityColor}"
                        BorderThickness="1"
                        CornerRadius="6" 
                        Padding="8,3">
                    <TextBlock Text="{Binding TagText}" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{Binding PriorityColor}" />
                </Border>

                <ui:Button Grid.Column="1"
                           Command="{Binding DeleteCommand}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="6,3"
                           ToolTip="Xóa thẻ nhiệm vụ"
                           Cursor="Hand">
                    <TextBlock Text="🗑️" FontSize="12" Opacity="0.6" />
                </ui:Button>
            </Grid>

            <!-- Row 1: Title -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Title}" 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <!-- Row 2: Description -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Description}" 
                       FontSize="12" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,10"
                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

            <!-- Row 3: Quick Navigation Buttons -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Move Left Button -->
                <ui:Button Grid.Column="0"
                           Command="{Binding MoveLeftCommand}"
                           Visibility="{Binding CanMoveLeft, Converter={StaticResource BoolToVis}}"
                           Background="{DynamicResource ControlFillColorSecondaryBrush}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           BorderThickness="1"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                           CornerRadius="8"
                           Padding="8,4"
                           ToolTip="Chuyển sang cột bên trái">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Lùi lại" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Move Right Button -->
                <ui:Button Grid.Column="2"
                           Command="{Binding MoveRightCommand}"
                           Visibility="{Binding CanMoveRight, Converter={StaticResource BoolToVis}}"
                           Background="{DynamicResource ControlFillColorSecondaryBrush}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           BorderThickness="1"
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                           CornerRadius="8"
                           Padding="8,4"
                           ToolTip="Chuyển sang cột bên phải">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tiếp tục" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="➡️" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
