<UserControl x:Class="StudyRoom.UI.Views.Components.TaskCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="280">
    
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Color="#64748B" Opacity="0.08" />
        </Border.Effect>

        <StackPanel>
            <!-- Header: Title & Navigation -->
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Lịch Học Tập" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Month Selector -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="PrevMonthButton" Content="‹" FontSize="16" Width="26" Height="26"
                               Padding="0" Background="Transparent" BorderThickness="0"
                               CornerRadius="13" Click="PrevMonth_Click" />
                    <TextBlock x:Name="MonthYearText" Text="Tháng 11, 2026" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="NextMonthButton" Content="›" FontSize="16" Width="26" Height="26"
                               Padding="0" Background="Transparent" BorderThickness="0"
                               CornerRadius="13" Click="NextMonth_Click" />
                </StackPanel>
            </Grid>

            <!-- Days of Week Header -->
            <UniformGrid Columns="7" Margin="0,0,0,8">
                <TextBlock Text="T2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="T3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="T4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="T5" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="T6" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="T7" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="CN" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </UniformGrid>

            <!-- Calendar Days Grid (Populated dynamically) -->
            <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6" Margin="0,0,0,4" />

            <!-- Footer: Scheduled Session Indicator -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="10,6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Hôm nay có 2 buổi học Pomodoro nhóm" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>