<UserControl x:Class="StudyRoom.UI.Views.PomodoroRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
             xmlns:components="clr-namespace:StudyRoom.UI.Views.Components"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PomodoroRoomViewModel}"
             d:DesignHeight="850" d:DesignWidth="1050">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Center Pomodoro Clock & Controls Area -->
            <ColumnDefinition Width="*" />
            <!-- Right Room Members & Baton Panel -->
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- 1. CENTER POMODORO CLOCK AREA              -->
        <!-- ========================================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,24,30,24">

                <!-- Navigation Back Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" 
                               Command="{Binding BackToDashboardCommand}" 
                               Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                               Padding="14,8" 
                               CornerRadius="10" 
                               BorderThickness="1" 
                               BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅️" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Quay lại Tổng quan" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RoomName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="#203222" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="🟢 Đang học" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subject}" FontSize="12" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Room Code Badge -->
                    <Border Grid.Column="2" 
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            CornerRadius="10" 
                            Padding="12,6" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1">
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <Run Text="Mã phòng: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding RoomId}" Foreground="#6366F1" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Clock Display Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="20" 
                        Padding="30,40" 
                        Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Radial Arc Countdown Clock -->
                        <components:RadialTimerControl Progress="{Binding Progress}" 
                                                      FormattedTime="{Binding FormattedTime}" 
                                                      PhaseText="{Binding PhaseText}" 
                                                      CycleText="{Binding CycleText}" 
                                                      Margin="0,0,0,32" />

                        <!-- Timer Control Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <!-- Case: Stopped -> Show Start Button -->
                            <ui:Button Command="{Binding StartCommand}" 
                                       Background="#6366F1" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="28,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,10,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bắt đầu học tập" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Case: Running -> Show Pause and Skip Buttons -->
                            <ui:Button Command="{Binding PauseCommand}" 
                                       Background="#F59E0B" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="24,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tạm dừng" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Case: Paused -> Show Resume and Reset Buttons -->
                            <ui:Button Command="{Binding ResumeCommand}" 
                                       Background="#10B981" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="24,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tiếp tục" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding ResetCommand}" 
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       Padding="18,12" 
                                       CornerRadius="12" 
                                       BorderThickness="1" 
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Đặt lại" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Skip Button: Always available during active session -->
                            <ui:Button Command="{Binding SkipCommand}" 
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       FontWeight="Medium" 
                                       FontSize="14" 
                                       Padding="18,12" 
                                       CornerRadius="12" 
                                       BorderThickness="1" 
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏭️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bỏ qua pha" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Study Tips Banner -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="14" 
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" 
                                   Text="Mẹo Pomodoro: Hãy tắt mọi thông báo mạng xã hội và tập trung duy nhất vào 1 bài tập. Đồng hồ sẽ tự động chuyển sang giờ nghỉ giải lao 5 phút sau khi kết thúc 25 phút tập trung." 
                                   FontSize="12" 
                                   Opacity="0.8" 
                                   TextWrapping="Wrap" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- 2. RIGHT ROOM MEMBERS PANEL                -->
        <!-- ========================================== -->
        <Border Grid.Column="1" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="1,0,0,0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Room Control Mode Status Card -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Padding="14" 
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Quyền điều khiển đồng hồ" FontSize="11" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ControlModeText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,4" />
                            <TextBlock Text="Chỉ người đang giữ gậy điều khiển (Baton) mới có thể Bắt đầu hoặc Tạm dừng chu kỳ học nhóm." FontSize="11" Opacity="0.75" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Active Members List Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thành viên trong phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#203222" CornerRadius="6" Padding="6,2">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80">
                                <Run Text="{Binding Members.Count, Mode=OneWay}" /><Run Text=" bạn đang học" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Members ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="12,10" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding AvatarEmoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Name & Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <!-- Host badge -->
                                                <Border Background="#312E81" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Host" FontSize="9" FontWeight="Bold" Foreground="#818CF8" />
                                                </Border>
                                                <!-- Baton badge -->
                                                <Border Background="#362B15" CornerRadius="4" Padding="4,1" Margin="4,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBaton}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Baton 🪄" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Action: Pass Baton Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Command="{Binding DataContext.PassBatonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                   CommandParameter="{Binding UserId}" 
                                                   Content="Nhường gậy" 
                                                   FontSize="10" 
                                                   Padding="6,3" 
                                                   CornerRadius="6" 
                                                   Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                   BorderThickness="1" 
                                                   BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                   VerticalAlignment="Center">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <!-- Show only if this member doesn't already have baton -->
                                                        <DataTrigger Binding="{Binding HasBaton}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
