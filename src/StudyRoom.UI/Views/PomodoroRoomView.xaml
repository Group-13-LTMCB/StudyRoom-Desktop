<UserControl x:Class="StudyRoom.UI.Views.PomodoroRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
             xmlns:components="clr-namespace:StudyRoom.UI.Views.Components"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PomodoroRoomViewModel}"
             d:DesignHeight="850" d:DesignWidth="1050"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ExitZenModeCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Center Pomodoro Clock & Controls Area -->
            <ColumnDefinition Width="*" />
            <!-- Right Room Members & Baton Panel -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="340" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- 1. CENTER POMODORO CLOCK AREA              -->
        <!-- ========================================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Zen Mode Exit Button (Top-Right Floating) -->
            <ui:Button Grid.Row="0"
                       Grid.RowSpan="2"
                       Command="{Binding ExitZenModeCommand}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="24"
                       Padding="14,8"
                       CornerRadius="10"
                       Background="{DynamicResource ControlFillColorSecondaryBrush}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       Panel.ZIndex="100">
                <ui:Button.Style>
                    <Style TargetType="ui:Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Thoát Zen Mode (Esc)" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <!-- Navigation Back Header -->
            <Grid Grid.Row="0" Margin="30,24,30,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" 
                           Command="{Binding BackToDashboardCommand}" 
                           Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           Padding="14,8" 
                           CornerRadius="10" 
                           BorderThickness="1" 
                           BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Quay lại Tổng quan" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RoomName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="#203222" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🟢 Đang học" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="12" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Room Code Badge -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                        CornerRadius="10" 
                        Padding="12,6" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1">
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <Run Text="Mã phòng: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding RoomId}" Foreground="#6366F1" />
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Clock Display Card (Row 1, Centered in Viewport) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="20" />
                            <Setter Property="Padding" Value="30,40" />
                            <Setter Property="Margin" Value="30,8,30,16" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Radial Arc Countdown Clock -->
                        <components:RadialTimerControl Progress="{Binding Progress}" 
                                                      FormattedTime="{Binding FormattedTime}" 
                                                      PhaseText="{Binding PhaseText}" 
                                                      CycleText="{Binding CycleText}" 
                                                      Margin="0,0,0,32" />

                        <!-- Timer Control Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <!-- Case: Stopped -> Show Start Button -->
                            <ui:Button Command="{Binding StartCommand}" 
                                       Background="#6366F1" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="28,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,10,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bắt đầu học tập" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Enter Zen Mode Button (Visible when NOT in Zen Mode) -->
                            <ui:Button Command="{Binding EnterZenModeCommand}"
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       BorderThickness="1"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Padding="18,12"
                                       CornerRadius="12"
                                       Margin="0,0,10,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧘" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Zen Mode" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Exit Zen Mode Button (Cluster, Visible when in Zen Mode) -->
                            <ui:Button Command="{Binding ExitZenModeCommand}"
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       BorderThickness="1"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Padding="18,12"
                                       CornerRadius="12"
                                       Margin="0,0,10,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Thoát Zen Mode (Esc)" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Case: Running -> Show Pause and Skip Buttons -->
                            <ui:Button Command="{Binding PauseCommand}" 
                                       Background="#F59E0B" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="24,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tạm dừng" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Case: Paused -> Show Resume and Reset Buttons -->
                            <ui:Button Command="{Binding ResumeCommand}" 
                                       Background="#10B981" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Padding="24,12" 
                                       CornerRadius="12" 
                                       BorderThickness="0" 
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Tiếp tục" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding ResetCommand}" 
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       Padding="18,12" 
                                       CornerRadius="12" 
                                       BorderThickness="1" 
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                       Margin="0,0,12,0">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Đặt lại" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Skip Button: Always available during active session -->
                            <ui:Button Command="{Binding SkipCommand}" 
                                       Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                       FontWeight="Medium" 
                                       FontSize="14" 
                                       Padding="18,12" 
                                       CornerRadius="12" 
                                       BorderThickness="1" 
                                       BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏭️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Bỏ qua pha" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                        </StackPanel>

                        <!-- Flashcard Break Challenge Button (Only visible during break phase AND NOT in Zen Mode) -->
                        <ui:Button Command="{Binding TriggerFlashcardCommand}"
                                   Background="#6366F1"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Padding="22,10"
                                   CornerRadius="12"
                                   BorderThickness="0"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBreakPhase}" Value="True" />
                                                <Condition Binding="{Binding IsZenMode}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Thử thách Flashcard" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Ambient Sound Controller (Visible in Zen Mode) -->
                        <Border Margin="0,28,0,0"
                                Padding="16,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎵 Âm thanh nền:" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,12,0" />

                                <!-- Rain -->
                                <ui:Button Command="{Binding SelectAmbientTrackCommand}" CommandParameter="Rain"
                                           Padding="12,6" Margin="0,0,6,0" CornerRadius="8" FontSize="12">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAmbientTrack}" Value="Rain">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="🌧️ Mưa rơi" />
                                </ui:Button>

                                <!-- Waves -->
                                <ui:Button Command="{Binding SelectAmbientTrackCommand}" CommandParameter="Waves"
                                           Padding="12,6" Margin="0,0,6,0" CornerRadius="8" FontSize="12">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAmbientTrack}" Value="Waves">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="🌊 Sóng biển" />
                                </ui:Button>

                                <!-- Cafe -->
                                <ui:Button Command="{Binding SelectAmbientTrackCommand}" CommandParameter="Cafe"
                                           Padding="12,6" Margin="0,0,6,0" CornerRadius="8" FontSize="12">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAmbientTrack}" Value="Cafe">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="☕ Quán cà phê" />
                                </ui:Button>

                                <!-- Fire -->
                                <ui:Button Command="{Binding SelectAmbientTrackCommand}" CommandParameter="Fire"
                                           Padding="12,6" Margin="0,0,6,0" CornerRadius="8" FontSize="12">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAmbientTrack}" Value="Fire">
                                                    <Setter Property="Background" Value="#6366F1" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="🔥 Lửa trại" />
                                </ui:Button>

                                <!-- Off -->
                                <ui:Button Command="{Binding SelectAmbientTrackCommand}" CommandParameter="Off"
                                           Padding="12,6" Margin="0,0,10,0" CornerRadius="8" FontSize="12">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAmbientTrack}" Value="Off">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <TextBlock Text="🔇 Tắt" />
                                </ui:Button>

                                <!-- Volume Slider -->
                                <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding AmbientVolume, UpdateSourceTrigger=PropertyChanged}" Width="90" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AmbientVolumePercentText}" FontSize="11" Width="36" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- Study Tips Banner (Row 2) -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="18,14"
                    Margin="30,0,30,24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" 
                               Text="Mẹo Pomodoro: Hãy tắt mọi thông báo mạng xã hội và tập trung duy nhất vào 1 bài tập. Đồng hồ sẽ tự động chuyển sang giờ nghỉ giải lao 5 phút sau khi kết thúc 25 phút tập trung." 
                               FontSize="12" 
                               Opacity="0.8" 
                               TextWrapping="Wrap" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. RIGHT ROOM MEMBERS PANEL                -->
        <!-- ========================================== -->
        <Border Grid.Column="1" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="1,0,0,0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                Padding="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Room Control Mode Status Card -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Padding="14" 
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Quyền điều khiển đồng hồ" FontSize="11" Opacity="0.65" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ControlModeText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,4" />
                            <TextBlock Text="Chỉ người đang giữ gậy điều khiển (Baton) mới có thể Bắt đầu hoặc Tạm dừng chu kỳ học nhóm." FontSize="11" Opacity="0.75" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Active Members List Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thành viên trong phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#203222" CornerRadius="6" Padding="6,2">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80">
                                <Run Text="{Binding Members.Count, Mode=OneWay}" /><Run Text=" bạn đang học" />
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Members ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="12,10" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding AvatarEmoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Name & Status -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <!-- Host badge -->
                                                <Border Background="#312E81" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Host" FontSize="9" FontWeight="Bold" Foreground="#818CF8" />
                                                </Border>
                                                <!-- Baton badge -->
                                                <Border Background="#362B15" CornerRadius="4" Padding="4,1" Margin="4,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBaton}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Baton 🪄" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Action: Pass Baton Button -->
                                        <ui:Button Grid.Column="2" 
                                                   Command="{Binding DataContext.PassBatonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                   CommandParameter="{Binding UserId}" 
                                                   Content="Nhường gậy" 
                                                   FontSize="10" 
                                                   Padding="6,3" 
                                                   CornerRadius="6" 
                                                   Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                   BorderThickness="1" 
                                                   BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                   VerticalAlignment="Center">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <!-- Show only if this member doesn't already have baton -->
                                                        <DataTrigger Binding="{Binding HasBaton}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
