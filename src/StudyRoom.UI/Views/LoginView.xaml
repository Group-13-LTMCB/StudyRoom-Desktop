<UserControl x:Class="StudyRoom.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
             xmlns:h="clr-namespace:StudyRoom.UI.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             d:DesignHeight="900" d:DesignWidth="1440"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Dark-only palette for this view; update these tokens together when retheming Login. -->
        <SolidColorBrush x:Key="SrInk" Color="#F4F0FF" />
        <SolidColorBrush x:Key="SrMuted" Color="#B4ACC6" />
        <SolidColorBrush x:Key="SrAccent" Color="#9A86F5" />
        <SolidColorBrush x:Key="SrAccentHover" Color="#AC9DF7" />
        <SolidColorBrush x:Key="SrAccentPressed" Color="#8170D8" />
        <SolidColorBrush x:Key="SrLime" Color="#3D4B27" />
        <SolidColorBrush x:Key="SrBrandBg" Color="#211C2C" />
        <SolidColorBrush x:Key="SrPageBg" Color="#16141D" />
        <SolidColorBrush x:Key="SrLine" Color="#3A3546" />
        <SolidColorBrush x:Key="SrLineHover" Color="#554D65" />
        <SolidColorBrush x:Key="SrStepBg" Color="#302A3B" />
        <SolidColorBrush x:Key="SrCheckBorder" Color="#6C647A" />
        <SolidColorBrush x:Key="SrRing" Color="#383146" />
        <SolidColorBrush x:Key="SrRingLime" Color="#687B39" />
        <SolidColorBrush x:Key="SrSurface" Color="#211E2A" />
        <SolidColorBrush x:Key="SrSurfaceHover" Color="#2A2636" />
        <SolidColorBrush x:Key="SrSurfacePressed" Color="#332E42" />

        <!-- Logo Google (vẽ lại bằng vector, không cần file ảnh) -->
        <DrawingImage x:Key="SrGoogleLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H48 V48 H0 Z" />
                    <GeometryDrawing Brush="#EA4335"
                                     Geometry="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <GeometryDrawing Brush="#4285F4"
                                     Geometry="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <GeometryDrawing Brush="#FBBC05"
                                     Geometry="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <GeometryDrawing Brush="#34A853"
                                     Geometry="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ================= Typography ================= -->
        <Style x:Key="SrTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
        </Style>

        <Style x:Key="SrBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SrMuted}" />
        </Style>

        <Style x:Key="SrCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SrMuted}" />
        </Style>

        <Style x:Key="SrLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SrBrandHeadline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="50" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="58" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
        </Style>

        <!-- ================= Hiện/ẩn nhóm nội dung theo chế độ ================= -->
        <Style x:Key="SrBrandSignIn" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSignInMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SrBrandSignUp" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSignUpMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConfirmOtpMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SrBrandRecover" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsForgotPasswordMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsResetPasswordMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= Nút ================= -->
        <!-- Nút chính (tím, có mũi tên; tự hiện vòng xoay khi IsBusy) -->
        <Style x:Key="SrPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SrAccent}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SrAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SrAccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" Foreground="White"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Foreground="White"
                                             Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút "Tiếp tục với Google" -->
        <Style x:Key="SrGoogleButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SrSurface}" BorderBrush="{DynamicResource SrLine}"
                                BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SrSurfaceHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SrLineHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SrSurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource SrGoogleLogo}" Width="18" Height="18" />
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource SrInk}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút dạng liên kết chữ tím -->
        <Style x:Key="SrLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SrAccent}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút "← Quay lại đăng nhập" -->
        <Style x:Key="SrBackButton" TargetType="Button" BasedOn="{StaticResource SrLinkButton}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18"
                                           Foreground="{DynamicResource SrAccent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút con mắt hiện/ẩn mật khẩu -->
        <Style x:Key="SrEyeToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <ui:SymbolIcon x:Name="Ico" Symbol="EyeOff24" FontSize="20"
                                           Foreground="{DynamicResource SrMuted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ico" Property="Symbol" Value="Eye24" />
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SrAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SrInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Ô nhập ================= -->
        <Style x:Key="SrTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SrInk}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource SrSurface}" BorderBrush="{DynamicResource SrLine}"
                                BorderThickness="1" CornerRadius="12" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Path=(h:InputAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="20" Foreground="{DynamicResource SrMuted}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                    <TextBlock x:Name="Ph"
                                               Text="{Binding Path=(h:InputAssist.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SrMuted}" IsHitTestVisible="False"
                                               Visibility="Collapsed" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SrLineHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SrAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SrPasswordBox" TargetType="PasswordBox">
            <Setter Property="h:InputAssist.Monitor" Value="True" />
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SrInk}" />
            <Setter Property="PasswordChar" Value="●" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{DynamicResource SrSurface}" BorderBrush="{DynamicResource SrLine}"
                                BorderThickness="1" CornerRadius="12" Padding="14,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Path=(h:InputAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="20" Foreground="{DynamicResource SrMuted}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                    <TextBlock x:Name="Plain"
                                               Text="{Binding Path=(h:InputAssist.PlainText), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SrInk}" Background="{DynamicResource SrSurface}"
                                               IsHitTestVisible="False" Visibility="Collapsed"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Ph"
                                               Text="{Binding Path=(h:InputAssist.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SrMuted}" IsHitTestVisible="False"
                                               Visibility="Collapsed" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ToggleButton Grid.Column="2" Style="{StaticResource SrEyeToggle}"
                                              IsChecked="{Binding Path=(h:InputAssist.IsRevealed), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="h:InputAssist.HasPassword" Value="False">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="h:InputAssist.IsRevealed" Value="True">
                                <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SrLineHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SrAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Checkbox ================= -->
        <Style x:Key="SrCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource SrInk}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{DynamicResource SrSurface}" BorderBrush="{DynamicResource SrCheckBorder}"
                                    BorderThickness="1" VerticalAlignment="Top">
                                <Path x:Name="Tick" Data="M4,9.5 L7.5,13 L14,5.5" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="-1,-1,0,0" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SrAccent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SrAccent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SrAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SrPageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="640*" />
            <ColumnDefinition Width="800*" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- CỘT TRÁI: BRAND PANEL                                  -->
        <!-- ====================================================== -->
        <Border Grid.Column="0" Background="{DynamicResource SrBrandBg}" ClipToBounds="True">
            <Grid>
                <!-- Vòng tròn trang trí (neo góc phải-dưới) -->
                <Ellipse Width="470" Height="470" Stroke="{DynamicResource SrRing}" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,4,-206" IsHitTestVisible="False" />
                <Ellipse Width="380" Height="380" Stroke="{DynamicResource SrRing}" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,49,-161" IsHitTestVisible="False" />
                <Ellipse Width="263" Height="263" Stroke="{DynamicResource SrRingLime}" StrokeThickness="28"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,107,-102" IsHitTestVisible="False" />

                <!-- Logo -->
                <TextBlock Text="StudyRoom" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource SrInk}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,44,0,0" />

                <!-- ===== Nội dung khi ĐĂNG NHẬP ===== -->
                <Grid Style="{StaticResource SrBrandSignIn}">
                    <Border Background="{DynamicResource SrLime}" CornerRadius="14" Height="32"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,177,0,0">
                        <TextBlock Text="HỌC CÙNG NHAU" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SrInk}" Margin="20,0"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Style="{StaticResource SrBrandHeadline}"
                               VerticalAlignment="Top" Margin="56,236,40,0">
                        <Run Text="Chào bạn," /><LineBreak /><Run Text="mừng trở lại!" />
                    </TextBlock>

                    <TextBlock Text="Một góc học quen, một ngày tiến bộ mới." FontSize="17"
                               Foreground="{DynamicResource SrMuted}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Margin="56,378,40,0" />

                    <Border Width="72" Height="6" CornerRadius="3" Background="{DynamicResource SrAccent}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,438,0,0" />

                    <Border Background="{DynamicResource SrPageBg}" CornerRadius="14" Padding="24"
                            VerticalAlignment="Top" Margin="56,532,56,0">
                        <StackPanel>
                            <TextBlock Text="Mỗi ngày một chút, tiến xa hơn." FontSize="14"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SrInk}" />
                            <TextBlock Text="Vào phòng học, bật tập trung và cùng nhau chinh phục mục tiêu hôm nay."
                                       Style="{StaticResource SrBody}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Nội dung khi ĐĂNG KÝ / XÁC THỰC OTP ===== -->
                <Grid Style="{StaticResource SrBrandSignUp}">
                    <Border Background="{DynamicResource SrLime}" CornerRadius="14" Height="32"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,177,0,0">
                        <TextBlock Text="HỌC CÙNG NHAU" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SrInk}" Margin="20,0"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Style="{StaticResource SrBrandHeadline}"
                               VerticalAlignment="Top" Margin="56,236,40,0">
                        <Run Text="Học cùng nhau." /><LineBreak /><Run Text="Giỏi hơn mỗi ngày." />
                    </TextBlock>

                    <TextBlock Text="Tạo tài khoản, tìm đồng đội, cùng tiến bộ." FontSize="17"
                               Foreground="{DynamicResource SrMuted}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Margin="56,378,40,0" />

                    <Border Width="72" Height="6" CornerRadius="3" Background="{DynamicResource SrAccent}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,438,0,0" />
                </Grid>

                <!-- ===== Nội dung khi QUÊN / ĐẶT LẠI MẬT KHẨU ===== -->
                <Grid Style="{StaticResource SrBrandRecover}">
                    <Border Background="{DynamicResource SrLime}" CornerRadius="14" Height="32"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,177,0,0">
                        <TextBlock Text="BẮT ĐẦU LẠI" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource SrInk}" Margin="20,0"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Style="{StaticResource SrBrandHeadline}"
                               VerticalAlignment="Top" Margin="56,236,40,0">
                        <Run Text="Quên mật khẩu?" /><LineBreak /><Run Text="Đừng lo nhé." />
                    </TextBlock>

                    <TextBlock Text="Chỉ vài bước để trở lại góc học của bạn." FontSize="17"
                               Foreground="{DynamicResource SrMuted}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Margin="56,378,40,0" />

                    <Border Width="72" Height="6" CornerRadius="3" Background="{DynamicResource SrAccent}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,438,0,0" />

                    <Border Background="{DynamicResource SrPageBg}" CornerRadius="18" Padding="24"
                            VerticalAlignment="Top" Margin="56,510,56,0">
                        <StackPanel>
                            <TextBlock Text="TRỞ LẠI STUDYROOM THẬT DỄ" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource SrAccent}" Margin="0,0,0,18" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SrLime}">
                                    <TextBlock Text="1" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SrInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Kiểm tra hộp thư của bạn" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource SrInk}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SrStepBg}">
                                    <TextBlock Text="2" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SrInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Nhập mã xác thực nhận được" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource SrInk}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SrStepBg}">
                                    <TextBlock Text="3" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SrInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tạo mật khẩu mới và đăng nhập" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource SrInk}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ====================================================== -->
        <!-- CỘT PHẢI: FORM XÁC THỰC                                -->
        <!-- ====================================================== -->
        <Grid Grid.Column="1" Background="{DynamicResource SrPageBg}">
            <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Thông báo lỗi / thành công -->
                <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,16"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Message="{Binding ErrorMessage}" />
                <ui:InfoBar Severity="Success" IsClosable="False" Margin="0,0,0,16"
                            IsOpen="{Binding HasSuccess, Mode=OneWay}"
                            Message="{Binding SuccessMessage}" />

                <!-- ================= 1. ĐĂNG NHẬP ================= -->
                <StackPanel Visibility="{Binding IsSignInMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Đăng nhập" Style="{StaticResource SrTitle}" Margin="0,0,0,20" />

                    <Button Style="{StaticResource SrGoogleButton}" Content="Tiếp tục với Google"
                            Command="{Binding ContinueWithGoogleCommand}" Margin="0,0,0,20" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="1" Fill="{DynamicResource SrLine}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="hoặc dùng email" Style="{StaticResource SrCaption}"
                                   Margin="12,0" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource SrLine}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Email" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}"
                                 h:InputAssist.Icon="Mail24" h:InputAssist.Placeholder="ban@example.com"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource SrLabel}" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource SrPasswordBox}"
                                     h:InputAssist.Icon="LockClosed24"
                                     h:InputAssist.Placeholder="Nhập mật khẩu của bạn"
                                     PasswordChanged="PasswordInput_PasswordChanged" />
                    </StackPanel>

                    <Grid Margin="0,0,0,20">
                        <CheckBox Style="{StaticResource SrCheckBox}" Content="Ghi nhớ tôi"
                                  IsChecked="{Binding RememberMe}" HorizontalAlignment="Left"
                                  VerticalContentAlignment="Center" />
                        <Button Style="{StaticResource SrLinkButton}" Content="Quên mật khẩu?"
                                FontSize="12" FontWeight="SemiBold" Padding="0,2"
                                Command="{Binding ShowForgotPasswordCommand}" HorizontalAlignment="Right" />
                    </Grid>

                    <Button Style="{StaticResource SrPrimaryButton}" Content="Đăng nhập"
                            Command="{Binding LoginCommand}" />

                    <Button Style="{StaticResource SrLinkButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Content="Chưa có tài khoản?  Đăng ký ngay"
                            Command="{Binding ShowRegisterCommand}" />

                    <!-- Giữ lại chức năng chế độ Khách của bản cũ -->
                    <Button Style="{StaticResource SrLinkButton}" Margin="0,4,0,0"
                            HorizontalAlignment="Center" FontSize="12"
                            Foreground="{DynamicResource SrMuted}"
                            Content="Dùng thử ở chế độ Khách (Offline)"
                            Command="{Binding ContinueAsGuestCommand}" />
                </StackPanel>

                <!-- ================= 2. ĐĂNG KÝ ================= -->
                <StackPanel Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Tạo tài khoản" Style="{StaticResource SrTitle}" Margin="0,0,0,16" />

                    <Button Style="{StaticResource SrGoogleButton}" Content="Tiếp tục với Google"
                            Command="{Binding ContinueWithGoogleCommand}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="1" Fill="{DynamicResource SrLine}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="hoặc dùng email" Style="{StaticResource SrCaption}"
                                   Margin="12,0" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource SrLine}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Tên của bạn" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}"
                                 h:InputAssist.Icon="Person24" h:InputAssist.Placeholder="Bạn muốn được gọi là gì?"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Email" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}"
                                 h:InputAssist.Icon="Mail24" h:InputAssist.Placeholder="ban@example.com"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource SrLabel}" />
                        <PasswordBox x:Name="RegisterPasswordInput" Style="{StaticResource SrPasswordBox}"
                                     h:InputAssist.Icon="LockClosed24"
                                     h:InputAssist.Placeholder="Tạo mật khẩu"
                                     PasswordChanged="RegisterPasswordInput_PasswordChanged" />
                        <TextBlock Text="Ít nhất 8 ký tự, gồm chữ và số." Style="{StaticResource SrCaption}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <CheckBox Style="{StaticResource SrCheckBox}" Margin="0,0,0,16"
                              VerticalContentAlignment="Top"
                              IsChecked="{Binding AcceptTerms}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" FontWeight="Normal" LineHeight="16"
                                   Foreground="{DynamicResource SrMuted}">
                            <Run Text="Tôi đồng ý với " /><Run Text="Điều khoản sử dụng" Foreground="{DynamicResource SrAccent}" /><Run Text=" và " /><Run Text="Chính sách bảo mật" Foreground="{DynamicResource SrAccent}" /><Run Text=" của StudyRoom." />
                        </TextBlock>
                    </CheckBox>

                    <Button Style="{StaticResource SrPrimaryButton}" Content="Tạo tài khoản"
                            Command="{Binding RegisterCommand}" />

                    <Button Style="{StaticResource SrLinkButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Content="Đã có tài khoản?  Đăng nhập"
                            Command="{Binding ShowLoginCommand}" />
                </StackPanel>

                <!-- ================= 3. XÁC THỰC OTP (không có trong Figma, cùng phong cách) ================= -->
                <StackPanel Visibility="{Binding IsConfirmOtpMode, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SrBackButton}" Content="Quay lại đăng nhập"
                            Command="{Binding ShowLoginCommand}" Margin="0,0,0,20" />

                    <TextBlock Text="Xác thực email" Style="{StaticResource SrTitle}" Margin="0,0,0,20" />
                    <TextBlock Text="Nhập mã gồm 6 chữ số vừa được gửi đến hộp thư của bạn để kích hoạt tài khoản."
                               Style="{StaticResource SrBody}" Margin="0,0,0,20" />

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Mã xác thực" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}" MaxLength="6"
                                 h:InputAssist.Icon="Mail24" h:InputAssist.Placeholder="123456"
                                 Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Style="{StaticResource SrPrimaryButton}" Content="Xác nhận"
                            Command="{Binding ConfirmOtpCommand}" />

                    <Button Style="{StaticResource SrLinkButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Content="Chưa nhận được mã?  Gửi lại"
                            Command="{Binding ResendOtpCommand}" />
                </StackPanel>

                <!-- ================= 4. QUÊN MẬT KHẨU ================= -->
                <StackPanel Visibility="{Binding IsForgotPasswordMode, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SrBackButton}" Content="Quay lại đăng nhập"
                            Command="{Binding ShowLoginCommand}" Margin="0,0,0,20" />

                    <TextBlock Text="Đặt lại mật khẩu" Style="{StaticResource SrTitle}" Margin="0,0,0,20" />
                    <TextBlock Text="Nhập email đã đăng ký. Chúng tôi sẽ gửi mã xác thực để bạn tạo mật khẩu mới."
                               Style="{StaticResource SrBody}" Margin="0,0,0,20" />

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Email của bạn" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}"
                                 h:InputAssist.Icon="Mail24" h:InputAssist.Placeholder="ban@example.com"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Style="{StaticResource SrPrimaryButton}" Content="Gửi mã xác thực"
                            Command="{Binding SendForgotPasswordCodeCommand}" />

                    <StackPanel Margin="0,28,0,0">
                        <TextBlock Text="Chưa thấy email?" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SrInk}" />
                        <TextBlock Text="Kiểm tra mục Spam hoặc thử lại với email khác."
                                   Style="{StaticResource SrCaption}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource SrLinkButton}" Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Content="Nhớ mật khẩu rồi?  Đăng nhập"
                            Command="{Binding ShowLoginCommand}" />
                </StackPanel>

                <!-- ================= 5. TẠO MẬT KHẨU MỚI (không có trong Figma, cùng phong cách) ================= -->
                <StackPanel Visibility="{Binding IsResetPasswordMode, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SrBackButton}" Content="Quay lại đăng nhập"
                            Command="{Binding ShowLoginCommand}" Margin="0,0,0,20" />

                    <TextBlock Text="Tạo mật khẩu mới" Style="{StaticResource SrTitle}" Margin="0,0,0,20" />
                    <TextBlock Text="Nhập mã xác thực đã nhận qua email và mật khẩu mới của bạn."
                               Style="{StaticResource SrBody}" Margin="0,0,0,20" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Mã xác thực" Style="{StaticResource SrLabel}" />
                        <TextBox Style="{StaticResource SrTextBox}" MaxLength="6"
                                 h:InputAssist.Icon="Mail24" h:InputAssist.Placeholder="Nhập mã 6 số"
                                 Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Mật khẩu mới" Style="{StaticResource SrLabel}" />
                        <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource SrPasswordBox}"
                                     h:InputAssist.Icon="LockClosed24"
                                     h:InputAssist.Placeholder="Tạo mật khẩu mới"
                                     PasswordChanged="NewPasswordInput_PasswordChanged" />
                        <TextBlock Text="Ít nhất 8 ký tự, gồm chữ và số." Style="{StaticResource SrCaption}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource SrPrimaryButton}" Content="Cập nhật mật khẩu"
                            Command="{Binding ConfirmResetPasswordCommand}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
