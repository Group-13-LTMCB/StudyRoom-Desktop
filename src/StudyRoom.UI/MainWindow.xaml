<ui:FluentWindow x:Class="StudyRoom.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StudyRoom.UI.ViewModels"
        xmlns:views="clr-namespace:StudyRoom.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
        Title="StudyRoom - Không gian Học Tập &amp; Làm Việc Nhóm"
        Height="840" Width="1300"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Login spans both rows; the TitleBar is layered last so it stays above either view. -->
        <views:LoginView x:Name="LoginControl" Grid.RowSpan="2" Visibility="Collapsed" />
        <views:DashboardView x:Name="DashboardControl" Grid.Row="1" Visibility="Visible" />

        <!-- Keep title-bar controls on the dark-theme text brush for contrast. -->
        <ui:TitleBar Grid.Row="0" Title="StudyRoom Desktop"
                     ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" />
    </Grid>
</ui:FluentWindow>
