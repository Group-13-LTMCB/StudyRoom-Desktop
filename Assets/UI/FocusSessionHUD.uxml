<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/FocusSession.uss" />

    <ui:VisualElement name="RootContainer" class="root-container" picking-mode="Ignore">

        <!-- 1. Góc trên bên phải: Huy hiệu Điểm rèn luyện -->
        <ui:VisualElement name="TrainingPointsHUD" class="wood-badge top-right">
            <ui:Label text="🏅" class="badge-icon" />
            <ui:Label name="TrainingPointsLabel" text="0" class="hud-points-value" />
        </ui:VisualElement>

        <!-- 2. Góc dưới bên phải: Timer Widget với vòng viền tiến trình (Mặc định ẩn) -->
        <ui:VisualElement name="TimerWidget" class="timer-card bottom-right hidden">
            <ui:VisualElement name="TimerProgressRing" class="timer-progress-ring" picking-mode="Ignore" />
            <ui:VisualElement class="timer-status-row">
                <ui:VisualElement class="green-dot" />
                <ui:Label name="TimerTagLabel" text="Study" class="timer-tag-text" />
            </ui:VisualElement>
            <ui:Label name="TimerLabel" text="25:00" class="timer-countdown" />
        </ui:VisualElement>

        <!-- 3. Popup Cài đặt phiên học (Mặc định ẩn - chỉ mở khi click ghế) -->
        <ui:VisualElement name="SessionSetupModal" class="modal-overlay hidden">
            <ui:VisualElement class="cream-modal-card">
                <ui:Label text="Thiết lập phiên học" class="modal-title" />
                <ui:Label name="DurationValueLabel" text="25m" class="duration-big-label" />

                <ui:SliderInt name="DurationSlider" low-value="1" high-value="90" value="25" class="cozy-slider" />

                <ui:VisualElement class="preset-row">
                    <ui:Button name="Preset15Button" text="15m" class="preset-chip" />
                    <ui:Button name="Preset25Button" text="25m" class="preset-chip" />
                    <ui:Button name="Preset45Button" text="45m" class="preset-chip" />
                    <ui:Button name="Preset60Button" text="60m" class="preset-chip" />
                    <ui:Button name="Preset90Button" text="90m" class="preset-chip" />
                </ui:VisualElement>

                <ui:VisualElement class="tag-row">
                    <ui:Label text="Session Tag:" class="field-label" />
                    <ui:TextField name="SessionTagInput" value="Study" class="tag-input" />
                </ui:VisualElement>

                <ui:Label name="EstimatedRewardLabel" text="Total Reward: +25 Điểm rèn luyện" class="reward-preview" />
                <ui:Button name="StartSessionButton" text="Start a session" class="cta-blue-button" />

                <ui:VisualElement class="modal-footer-bar">
                    <ui:Button name="CloseSetupButton" text="✕" class="icon-circle-button" />
                    <ui:Button name="SoundToggleButton" text="🔊" class="icon-circle-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4. Popup Hoàn thành & Nhận điểm (Mặc định ẩn) -->
        <ui:VisualElement name="CompletionModal" class="modal-overlay hidden">
            <ui:VisualElement class="cream-modal-card">
                <ui:Label text="🔥" class="completion-hero-icon" />
                <ui:Label text="Phiên học hoàn thành!" class="modal-title" />
                <ui:Label name="EarnedPointsLabel" text="+25 Điểm rèn luyện" class="completion-reward-text" />
                <ui:Button name="ContinueButton" text="Continue" class="cta-blue-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 5. Vùng báo lỗi RPC thất bại (Mặc định ẩn) -->
        <ui:VisualElement name="ErrorBanner" class="error-banner hidden">
            <ui:Label name="ErrorMessageLabel" text="Lỗi kết nối máy chủ (RPC failed)." class="error-text" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>