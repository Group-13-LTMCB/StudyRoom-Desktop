.root-container {
    width: 100%;
    height: 100%;
    position: relative;
}

.hidden {
    display: none;
}

/* --- 1. Huy hiệu Điểm rèn luyện (Góc trên phải - Nâu gỗ trầm) --- */
.wood-badge {
    position: absolute;
    background-color: #3E2723;
    border-color: #6D4C41;
    border-width: 2px;
    border-radius: 22px;
    padding: 10px 18px;
    flex-direction: row;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.18s;
}

.wood-badge--punch {
    scale: 1.22 1.22;
}

.top-right {
    top: 24px;
    right: 24px;
}

.badge-icon {
    font-size: 20px;
    margin-right: 8px;
}

.hud-points-value {
    color: #FFF8E1;
    font-size: 20px;
    -unity-font-style: bold;
}

/* --- 2. Timer Widget (Góc dưới phải - Nâu gỗ + Viền tiến trình động) --- */
.timer-card {
    position: absolute;
    background-color: #3E2723;
    border-width: 0;
    border-radius: 20px;
    padding: 16px 24px;
    min-width: 165px;
    align-items: flex-end;
}

.timer-progress-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bottom-right {
    bottom: 24px;
    right: 24px;
}

.timer-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.green-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: #66BB6A;
    margin-right: 6px;
}

.timer-tag-text {
    color: #FFF8E1;
    font-size: 14px;
    -unity-font-style: bold;
}

.timer-countdown {
    color: #FFFDE7;
    font-size: 32px;
    -unity-font-style: bold;
}

/* --- 3 & 4. Popup Modal Nền Kem Ấm (#FFF8E1 / #FFFDE7) --- */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(62, 39, 35, 0.45);
    justify-content: center;
    align-items: center;
}

.cream-modal-card {
    width: 410px;
    background-color: #FFF8E1;
    border-color: #4E342E;
    border-width: 3px;
    border-radius: 26px;
    padding: 26px 28px 22px 28px;
    align-items: center;
}

.modal-title {
    font-size: 22px;
    color: #3E2723;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.duration-big-label {
    font-size: 36px;
    color: #4E342E;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.cozy-slider {
    width: 100%;
    margin-bottom: 14px;
}

/* Các nút mốc gợi ý thời gian */
.preset-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
}

.preset-chip {
    background-color: #FFFDE7;
    color: #4E342E;
    border-color: #BCAAA4;
    border-width: 1px;
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
}

.preset-chip:hover {
    background-color: #4CAF50;
    color: #FFFDE7;
    border-color: #4CAF50;
}

/* Hàng nhập Session Tag */
.tag-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
}

.field-label {
    color: #4E342E;
    font-size: 14px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.tag-input {
    flex-grow: 1;
}

.tag-input > .unity-text-field__input {
    background-color: #FFFDE7;
    color: #3E2723;
    border-color: #BCAAA4;
    border-width: 1px;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 14px;
}

/* Dự tính phần thưởng */
.reward-preview {
    color: #2E7D32;
    background-color: rgba(102, 187, 106, 0.18);
    border-radius: 12px;
    padding: 8px 14px;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

/* Nút CTA Xanh dương thân thiện (#42A5F5 / #1E88E5) */
.cta-blue-button {
    width: 100%;
    height: 48px;
    background-color: #42A5F5;
    color: #FFFFFF;
    font-size: 17px;
    -unity-font-style: bold;
    border-radius: 16px;
    border-width: 0;
}

.cta-blue-button:hover {
    background-color: #1E88E5;
}

.cta-blue-button:active {
    background-color: #1565C0;
}

/* Thanh chân modal: Nút (X) & Âm thanh */
.modal-footer-bar {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 16px;
}

.icon-circle-button {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background-color: #4E342E;
    color: #FFF8E1;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 0;
}

.icon-circle-button:hover {
    background-color: #3E2723;
}

/* Completion Modal */
.completion-hero-icon {
    font-size: 44px;
    margin-bottom: 6px;
}

.completion-reward-text {
    font-size: 22px;
    color: #4CAF50;
    -unity-font-style: bold;
    margin: 14px 0 22px 0;
}

/* --- 5. Vùng báo lỗi RPC --- */
.error-banner {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    background-color: #C62828;
    border-color: #FFF8E1;
    border-width: 2px;
    padding: 12px 24px;
    border-radius: 16px;
}

.error-text {
    color: #FFFDE7;
    font-size: 14px;
    -unity-font-style: bold;
}
/* --- Thanh tiến trình bên trong Timer Widget --- */
.timer-progress-track {
    width: 100%;
    height: 6px;
    background-color: rgba(255, 248, 225, 0.2);
    border-radius: 3px;
    margin-top: 8px;
    overflow: hidden;
}

.timer-progress-fill {
    width: 100%;
    height: 100%;
    background-color: #66BB6A;
    border-radius: 3px;
}